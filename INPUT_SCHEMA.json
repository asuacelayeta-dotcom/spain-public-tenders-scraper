{
    "title": "Spain Public Tenders Scraper — PLACSP",
    "description": "Search live public tenders from Spain's official PLACSP platform. An AI agent can call this tool to find open tenders by business keyword, contract type, or CPV code. Status is required.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "estado": {
            "title": "Estado",
            "type": "string",
            "editor": "select",
            "description": "Tender status to search. Use 'Publicado' for tenders currently open for bidding (the usual choice for finding opportunities). Required.",
            "enum": [
                "Publicado",
                "Activo"
            ],
            "enumTitles": [
                "Publicado",
                "Activo"
            ],
            "default": "Publicado"
        },
        "keyword": {
            "title": "Palabra clave",
            "type": "string",
            "editor": "textfield",
            "description": "Primary business search term in Spanish (e.g. 'paneles fotovoltaicos', 'control de fauna', 'software'). The Actor expands it via a 14-sector dictionary into related terms, so a plain business word returns procurement-grade results. This is the main filter when present."
        },
        "tipo_contrato": {
            "title": "Tipo de contrato",
            "type": "string",
            "editor": "select",
            "description": "Contract type. Used as the primary filter only when no keyword is given. Options: Obras (works), Servicios (services), Suministros (supplies), and concession/patrimonial types.",
            "enum": [
                "",
                "Obras",
                "Servicios",
                "Suministros",
                "Administrativo especial",
                "Privado",
                "Gestión de Servicios Públicos",
                "Concesión de Servicios",
                "Concesión de Obras Públicas",
                "Concesión de Obras",
                "Colaboración entre el sector público y sector privado",
                "Patrimonial"
            ],
            "enumTitles": [
                "-- Selecciona --",
                "Obras",
                "Servicios",
                "Suministros",
                "Administrativo especial",
                "Privado",
                "Gestión de Servicios Públicos",
